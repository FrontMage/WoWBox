+static WCHAR ascii_tolowerW(WCHAR ch)
+{
+    if (ch >= 'A' && ch <= 'Z') return ch + ('a' - 'A');
+    return ch;
+}
+
+static BOOL basename_equals(const WCHAR *name, const WCHAR *expected)
+{
+    while (*name && *expected)
+    {
+        if (ascii_tolowerW(*name++) != ascii_tolowerW(*expected++)) return FALSE;
+    }
+    return !*name && !*expected;
+}
+
+static BOOL WINAPI check_bridge_process_once(INIT_ONCE *once, void *param, void **context)
+{
+    WCHAR path[MAX_PATH];
+    WCHAR *basename;
+    DWORD len;
+
+    len = GetModuleFileNameW(NULL, path, ARRAY_SIZE(path));
+    if (!len || len >= ARRAY_SIZE(path)) return TRUE;
+
+    basename = path + len;
+    while (basename > path && basename[-1] != '\\' && basename[-1] != '/') basename--;
+
+    bridge_process_allowed = basename_equals(basename, L"Wow.exe") ||
+                             basename_equals(basename, L"WowClassic.exe");
+    return TRUE;
+}
+
+static BOOL bridge_enabled_for_process(void)
+{
+    InitOnceExecuteOnce(&bridge_process_once, check_bridge_process_once, NULL, NULL);
+    return bridge_process_allowed;
+}
