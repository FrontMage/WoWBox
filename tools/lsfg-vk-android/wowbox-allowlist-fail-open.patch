diff --git a/include/wowbox/application_filter.hpp b/include/wowbox/application_filter.hpp
new file mode 100644
index 0000000..7a92e7f
--- /dev/null
+++ b/include/wowbox/application_filter.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <string>
+
+namespace WowBox {
+    inline std::string normalizeApplicationName(const char* rawName) {
+        if (!rawName) return {};
+        std::string name(rawName);
+        const size_t separator = name.find_last_of("/\\");
+        if (separator != std::string::npos) name = name.substr(separator + 1);
+        std::ranges::transform(name, name.begin(),
+            [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
+        return name;
+    }
+
+    inline bool isAllowedApplicationName(const std::string& name) {
+        static constexpr std::array<const char*, 3> allowed{
+            "wow.exe", "wowclassic.exe", "testd3d.exe"
+        };
+        return std::ranges::any_of(allowed,
+            [&name](const char* candidate) { return name == candidate; });
+    }
+}
