+        static bool ready{};
+        std::lock_guard<std::mutex> lock(mutex);
+        if (attempted) return ready;
+        attempted = true;
+
+        try {
+            // Only the explicitly allowed Windows application may override
+            // Mesa's present mode or read Lossless.dll.
+            unsetenv("MESA_VK_WSI_PRESENT_MODE"); // NOLINT
+            Extract::extractShaders();
+            ready = true;
+            std::cerr << "lsfg-vk: WoW Box application matched: "
+                      << application << '\n';
+            std::cerr << "lsfg-vk: Shaders extracted successfully.\n";
+
+            // Diagnostic metadata is best effort and must never terminate the
+            // game when TMPDIR is unavailable or read-only.
+            const char* tmpdir = getenv("TMPDIR");
+            const std::string latestPath = tmpdir
+                ? std::string(tmpdir) + "/lsfg-vk_last"
+                : "/tmp/lsfg-vk_last";
+            std::ofstream latest(latestPath, std::ios::trunc);
+            if (latest.is_open()) {
+                latest << "application: " << application << '\n';
+                latest << "pid: " << getpid() << '\n';
+            }
+        } catch (const std::exception& e) {
+            std::cerr << "lsfg-vk: WoW Box initialization failed; "
+                         "continuing without frame generation:\n";
+            std::cerr << "- " << e.what() << '\n';
+            ready = false;
+        }
+        return ready;
+    }
 }

