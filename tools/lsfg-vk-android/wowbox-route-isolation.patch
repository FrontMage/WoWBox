diff --git a/tmp/lsfg-route-upstream.AFC9rG/source/include/wowbox/present_route_selector.hpp b/include/wowbox/present_route_selector.hpp
new file mode 100644
index 0000000..eb467fc
--- /dev/null
+++ b/include/wowbox/present_route_selector.hpp
@@ -0,0 +1,76 @@
+#pragma once
+
+#include <cstdint>
+#include <unordered_map>
+
+namespace WowBox {
+    class PresentRouteSelector {
+    public:
+        struct Decision {
+            bool selected{};
+            bool newlySelected{};
+        };
+
+        Decision observeSuccess(uintptr_t source, uint64_t nowMs) {
+            if (!source) return {};
+
+            if (owner_ && owner_ != source) {
+                auto ownerIt = candidates_.find(owner_);
+                if (ownerIt == candidates_.end()
+                        || nowMs > ownerIt->second.lastSuccessMs + OWNER_STALE_MS) {
+                    owner_ = 0;
+                }
+            }
+
+            auto& candidate = candidates_[source];
+            if (candidate.lastSuccessMs
+                    && nowMs > candidate.lastSuccessMs + CONTIGUOUS_PRESENT_MS) {
+                candidate.successCount = 0;
+            }
+            candidate.lastSuccessMs = nowMs;
+            if (candidate.successCount < REQUIRED_PRESENTS)
+                candidate.successCount++;
+
+            bool newlySelected{};
+            if (!owner_ && candidate.successCount >= REQUIRED_PRESENTS) {
+                owner_ = source;
+                newlySelected = true;
+            }
+            return {
+                .selected = owner_ == source,
+                .newlySelected = newlySelected
+            };
+        }
+
+        bool isSelected(uintptr_t source) const {
+            return source && owner_ == source;
+        }
+
+        void remove(uintptr_t source) {
+            candidates_.erase(source);
+            if (owner_ == source) owner_ = 0;
+        }
+
+        void reset() {
+            candidates_.clear();
+            owner_ = 0;
+        }
+
+        uintptr_t selectedSource() const {
+            return owner_;
+        }
+
+        static constexpr uint32_t REQUIRED_PRESENTS = 3;
+        static constexpr uint64_t CONTIGUOUS_PRESENT_MS = 1000;
+        static constexpr uint64_t OWNER_STALE_MS = 3000;
+
+    private:
+        struct Candidate {
+            uint32_t successCount{};
+            uint64_t lastSuccessMs{};
+        };
+
+        std::unordered_map<uintptr_t, Candidate> candidates_;
+        uintptr_t owner_{};
+    };
+}
diff --git a/tmp/lsfg-route-upstream.AFC9rG/source/src/dispatch_registry.cpp b/src/dispatch_registry.cpp
new file mode 100644
index 0000000..ba605a8
--- /dev/null
+++ b/src/dispatch_registry.cpp
@@ -0,0 +1,157 @@
+#include "wowbox/dispatch_registry.hpp"
+
+#include <mutex>
+#include <unordered_map>
+
+namespace {
+    std::mutex registryMutex;
+    std::unordered_map<VkInstance, std::shared_ptr<WowBox::InstanceDispatch>> instances;
+    std::unordered_map<VkPhysicalDevice, VkInstance> physicalDevices;
+    std::unordered_map<VkDevice, std::shared_ptr<WowBox::DeviceDispatch>> devices;
+    std::unordered_map<VkQueue, VkDevice> queues;
+    std::unordered_map<VkSwapchainKHR, VkDevice> swapchains;
+    std::unordered_map<VkCommandBuffer, VkDevice> commandBuffers;
+}
+
+void WowBox::registerInstance(
+        VkInstance instance, const InstanceDispatch& dispatch) {
+    std::lock_guard<std::mutex> lock(registryMutex);
+    instances[instance] = std::make_shared<InstanceDispatch>(dispatch);
+}
+
+std::shared_ptr<const WowBox::InstanceDispatch>
+WowBox::findInstance(VkInstance instance) {
+    std::lock_guard<std::mutex> lock(registryMutex);
+    auto it = instances.find(instance);
+    return it == instances.end() ? nullptr : it->second;
+}
+
+void WowBox::removeInstance(VkInstance instance) {
+    std::lock_guard<std::mutex> lock(registryMutex);
+    for (auto it = physicalDevices.begin(); it != physicalDevices.end();) {
+        if (it->second == instance)
+            it = physicalDevices.erase(it);
+        else
+            ++it;
+    }
+    instances.erase(instance);
+}
+
+void WowBox::registerPhysicalDevices(
+        VkInstance instance, uint32_t count, const VkPhysicalDevice* values) {
+    if (!values) return;
+    std::lock_guard<std::mutex> lock(registryMutex);
+    for (uint32_t i = 0; i < count; ++i)
+        physicalDevices[values[i]] = instance;
+}
+
+std::shared_ptr<const WowBox::InstanceDispatch>
+WowBox::findPhysicalDevice(VkPhysicalDevice device) {
+    std::lock_guard<std::mutex> lock(registryMutex);
+    auto physicalIt = physicalDevices.find(device);
+    if (physicalIt == physicalDevices.end()) return nullptr;
+    auto instanceIt = instances.find(physicalIt->second);
+    return instanceIt == instances.end() ? nullptr : instanceIt->second;
+}
+
+VkInstance WowBox::findPhysicalDeviceInstance(VkPhysicalDevice device) {
+    std::lock_guard<std::mutex> lock(registryMutex);
+    auto it = physicalDevices.find(device);
+    return it == physicalDevices.end() ? VK_NULL_HANDLE : it->second;
+}
+
+void WowBox::registerDevice(
+        VkDevice device, const DeviceDispatch& dispatch) {
+    std::lock_guard<std::mutex> lock(registryMutex);
+    devices[device] = std::make_shared<DeviceDispatch>(dispatch);
+}
+
+std::shared_ptr<const WowBox::DeviceDispatch>
+WowBox::findDevice(VkDevice device) {
+    std::lock_guard<std::mutex> lock(registryMutex);
+    auto it = devices.find(device);
+    return it == devices.end() ? nullptr : it->second;
+}
+
+void WowBox::removeDevice(VkDevice device) {
+    std::lock_guard<std::mutex> lock(registryMutex);
+    for (auto it = queues.begin(); it != queues.end();) {
+        if (it->second == device)
+            it = queues.erase(it);
+        else
+            ++it;
+    }
+    for (auto it = swapchains.begin(); it != swapchains.end();) {
+        if (it->second == device)
+            it = swapchains.erase(it);
+        else
+            ++it;
+    }
+    for (auto it = commandBuffers.begin(); it != commandBuffers.end();) {
+        if (it->second == device)
+            it = commandBuffers.erase(it);
+        else
+            ++it;
+    }
+    devices.erase(device);
+}
+
+void WowBox::registerQueue(VkQueue queue, VkDevice device) {
+    if (!queue) return;
+    std::lock_guard<std::mutex> lock(registryMutex);
+    queues[queue] = device;
+}
+
+std::shared_ptr<const WowBox::DeviceDispatch>
+WowBox::findQueue(VkQueue queue) {
+    std::lock_guard<std::mutex> lock(registryMutex);
+    auto queueIt = queues.find(queue);
+    if (queueIt == queues.end()) return nullptr;
+    auto deviceIt = devices.find(queueIt->second);
+    return deviceIt == devices.end() ? nullptr : deviceIt->second;
+}
+
+void WowBox::registerSwapchain(VkSwapchainKHR swapchain, VkDevice device) {
+    if (!swapchain) return;
+    std::lock_guard<std::mutex> lock(registryMutex);
+    swapchains[swapchain] = device;
+}
+
+void WowBox::removeSwapchain(VkSwapchainKHR swapchain) {
+    std::lock_guard<std::mutex> lock(registryMutex);
+    swapchains.erase(swapchain);
+}
+
+std::shared_ptr<const WowBox::DeviceDispatch>
+WowBox::findSwapchain(VkSwapchainKHR swapchain) {
+    std::lock_guard<std::mutex> lock(registryMutex);
+    auto swapchainIt = swapchains.find(swapchain);
+    if (swapchainIt == swapchains.end()) return nullptr;
+    auto deviceIt = devices.find(swapchainIt->second);
+    return deviceIt == devices.end() ? nullptr : deviceIt->second;
+}
+
+void WowBox::registerCommandBuffers(
+        VkDevice device, uint32_t count, const VkCommandBuffer* buffers) {
+    if (!buffers) return;
+    std::lock_guard<std::mutex> lock(registryMutex);
+    for (uint32_t i = 0; i < count; ++i)
+        commandBuffers[buffers[i]] = device;
+}
+
+void WowBox::removeCommandBuffers(
+        uint32_t count, const VkCommandBuffer* buffers) {
+    if (!buffers) return;
+    std::lock_guard<std::mutex> lock(registryMutex);
+    for (uint32_t i = 0; i < count; ++i)
+        commandBuffers.erase(buffers[i]);
+}
+
+std::shared_ptr<const WowBox::DeviceDispatch>
+WowBox::findCommandBuffer(VkCommandBuffer buffer) {
+    std::lock_guard<std::mutex> lock(registryMutex);
+    auto bufferIt = commandBuffers.find(buffer);
+    if (bufferIt == commandBuffers.end()) return nullptr;
+    auto deviceIt = devices.find(bufferIt->second);
+    return deviceIt == devices.end() ? nullptr : deviceIt->second;
+}
